# Copy to `.env` and fill in. NEVER put real values in this file — it is tracked
# by git (`.gitignore`'s `.env*` pattern does not match `env.example`).

# --- Database ---------------------------------------------------------------
# Postgres. Append `?schema=<name>` (or `&schema=<name>` if the URL already has
# query params) to keep Vibe's tables isolated from anything else in the database.
DATABASE_URL=""

# --- App --------------------------------------------------------------------
# Public origin of THIS app. Must be exact — the sandbox inspector only accepts
# postMessage traffic from origins on its allowlist, and this is one of them.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI providers -----------------------------------------------------------
# At least one key matching your chosen models is required.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROK_API_KEY=""

# Model selection by role. See src/lib/ai/providers.ts for the catalog.
AI_MODEL_CODE="gpt-5.6-terra"
AI_MODEL_EDIT="gpt-5.6-terra"
AI_MODEL_FAST="gpt-5.6-luna"

# --- E2B sandboxes ----------------------------------------------------------
E2B_API_KEY=""
# Built from sandbox-templates/nextjs:
#   cd sandbox-templates/nextjs
#   e2b template build --name vibe-nextjs-v3 --cmd "/compile_page.sh"
E2B_TEMPLATE_ID="vibe-nextjs-v3"

# --- Storage (published static sites) ---------------------------------------
# "db" = gzipped rows in Postgres (default, zero infra).
# "s3" = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze).
STORAGE_DRIVER="db"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional CDN/public base URL for the bucket. When set, static assets are
# redirected here instead of being streamed through the app.
S3_PUBLIC_BASE_URL=""

# --- Usage limits -----------------------------------------------------------
# "false" records consumption without ever blocking. Flip to "true" to enforce.
USAGE_ENFORCEMENT="false"

# --- Clerk ------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# --- Inngest (required in production; dev uses the local CLI) ----------------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
