// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

/// Lifecycle of the single long-lived E2B sandbox backing a project's preview.
enum SandboxStatus {
  NONE
  CREATING
  RUNNING
  EXPIRED
  FAILED
}

/// What kind of app a project builds. Decides the sandbox runtime, the system
/// prompt, and how publishing works.
enum Framework {
  NEXTJS
  STATIC_HTML
}

/// Lifecycle of a project's public share.
enum PublishStatus {
  NONE
  BUILDING
  LIVE
  EXPORT_FAILED
  REVIVE_ONLY
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Canonical file tree: { "app/page.tsx": "..." }. This — NOT Fragment.files —
  /// is the source of truth used to rehydrate sandboxes, apply edits and publish.
  files Json?
  /// Bumped on every mutation of `files`. Used for optimistic concurrency.
  filesVersion Int     @default(0)
  /// sha256 of package.json dependencies+devDependencies. Lets rehydration skip
  /// `npm ci` when the tree still matches the template baseline.
  depsHash     String?

  // --- sandbox lifecycle ---
  sandboxId        String?
  sandboxUrl       String?
  sandboxStatus    SandboxStatus @default(NONE)
  sandboxExpiresAt DateTime?
  sandboxBootedAt  DateTime?
  /// Set when a worker claims the right to create a sandbox; used to recover
  /// projects stuck in CREATING because a worker died.
  sandboxClaimedAt DateTime?
  sandboxError     String?
  lastActiveAt     DateTime      @default(now())

  // --- publishing ---
  shareSlug             String?       @unique
  isPublic              Boolean       @default(false)
  publishStatus         PublishStatus @default(NONE)
  publishedAt           DateTime?
  /// filesVersion at the time of the last successful publish; if this drifts
  /// behind filesVersion the UI offers a re-publish.
  publishedFilesVersion Int?
  publishBlobPrefix     String?
  viewCount             Int           @default(0)

  framework Framework @default(NEXTJS)

  /// Per-project model override; falls back to env defaults.
  modelId String?

  // --- token accounting (running totals; per-run detail lives on Message) ---
  totalPromptTokens     Int   @default(0)
  totalCompletionTokens Int   @default(0)
  /// Estimated USD from the pricing table in src/lib/ai/providers.ts. Not billed
  /// against — every surface that shows it labels it an estimate.
  totalCostUsd          Float @default(0)

  messages        Message[]
  edits           Edit[]
  agentEvents     AgentEvent[]
  publishAttempts PublishAttempt[]
  checkpoints     Checkpoint[]
  attachments     Attachment[]

  @@index([userId, updatedAt])
  @@index([sandboxStatus, sandboxExpiresAt])
}

// ---------------------------------------------------------------------------
// Checkpoints (file-tree history)
// ---------------------------------------------------------------------------

enum CheckpointKind {
  /// Written after a successful agent run.
  TURN
  /// Written when the user explicitly saves.
  MANUAL
  /// Written immediately before a restore, so restoring is itself undoable.
  PRE_RESTORE
  /// Throttled snapshot around manual editor saves.
  AUTO
}

/// A complete snapshot of a project's file tree at a point in time.
///
/// `Project.files` is overwritten in place, so without this a bad turn is
/// unrecoverable. Deliberately a full snapshot rather than a delta: deltas
/// cannot reconstruct a tree on their own, which is exactly the trap
/// `Fragment.files` fell into.
model Checkpoint {
  id        String         @id @default(uuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      CheckpointKind
  label     String
  messageId String?

  /// gzipped JSON of the complete file map. ~10x smaller than raw, which
  /// matters when this is written on every turn.
  snapshot     Bytes
  filesVersion Int
  fileCount    Int
  sizeBytes    Int

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

/// An image the user attached to a chat message.
///
/// Bytes live in Postgres rather than the StorageDriver: attachments are small
/// (downscaled client-side, hard-capped server-side) and this keeps them
/// cascade-deleted with the project. Storage-driver objects have no such link
/// and would leak once a project is removed.
model Attachment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set once the attachment is sent with a message; null while it is still a
  /// pending upload in the composer.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  name   String
  mime   String
  size   Int
  width  Int?
  height Int?
  data   Bytes

  /// Cached vision description, so re-running a turn doesn't re-pay for it.
  description String?  @db.Text

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([messageId])
}

/// md5 manifest of a pristine sandbox template.
///
/// Sandbox reconciliation diffs against this so it can tell "the agent's CLI
/// created this file" from "this is one of the 46 shadcn components the
/// template always ships".
model TemplateBaseline {
  templateId String   @id
  /// { "app/page.tsx": "<md5>", ... }
  manifest   Json
  fileCount  Int
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Messages
// ---------------------------------------------------------------------------

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

enum MessageStatus {
  PENDING
  RUNNING
  COMPLETE
  ERROR
  CANCELLED
}

/// What produced this message — drives how it renders in the chat.
enum MessageKind {
  CHAT
  TARGETED_EDIT
  FIX_ERROR
}

model Message {
  id        String        @id @default(uuid())
  content   String
  role      MessageRole
  type      MessageType
  status    MessageStatus @default(COMPLETE)
  kind      MessageKind   @default(CHAT)
  /// Structured context (e.g. the <selected_element> payload for targeted edits).
  /// Kept out of `content` so the chat bubble stays human-readable.
  metadata  Json?
  /// Inngest run id, so a generation can be cancelled.
  runId     String?

  // --- token accounting for the run that produced this message ---
  promptTokens     Int?
  completionTokens Int?
  /// Estimated USD for this run.
  costUsd          Float?
  /// Which model actually ran. Recorded per message because the project's
  /// model can change between turns, so cost cannot be recomputed after the
  /// fact from the project's current selection.
  usageModelId     String?
  /// Per-agent breakdown ({ "code-agent": {...}, "vision": {...} }), for the
  /// "where did the tokens go" view.
  usageDetail      Json?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fragment    Fragment?
  attachments Attachment[]

  @@index([projectId, createdAt])
}

model Fragment {
  id        String  @id @default(uuid())
  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl String
  title      String
  /// The files touched by THIS run — a per-turn changelog, not a full snapshot.
  /// Reconstructing an app requires Project.files.
  files      Json
  /// Project.filesVersion at the moment this fragment was written.
  filesVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Edits (deterministic, non-LLM mutations from the visual editor)
// ---------------------------------------------------------------------------

enum EditKind {
  TEXT
  STYLE
  ATTRIBUTE
  AI
  REVERT
  /// A save from the in-browser code editor.
  MANUAL
}

model Edit {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      EditKind
  filePath  String
  oldString String?  @db.Text
  newString String?  @db.Text
  /// The VibeElementLocator that produced this edit.
  locator   Json?
  fromVersion Int
  toVersion   Int
  revertedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Agent activity log (powers the live progress stream)
// ---------------------------------------------------------------------------

enum AgentEventType {
  STATUS
  THINKING
  TOOL_CALL
  TOOL_RESULT
  FILE_WRITE
  TERMINAL
  ERROR
  DONE
}

model AgentEvent {
  /// Globally monotonic; doubles as the SSE cursor.
  seq       Int            @id @default(autoincrement())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messageId String?
  type      AgentEventType
  label     String
  detail    Json?
  createdAt DateTime       @default(now())

  @@index([projectId, seq])
}

// ---------------------------------------------------------------------------
// Publishing
// ---------------------------------------------------------------------------

model PublishAttempt {
  id         String        @id @default(uuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     PublishStatus
  log        String?       @db.Text
  fileCount  Int?
  bytes      Int?
  durationMs Int?
  createdAt  DateTime      @default(now())

  @@index([projectId, createdAt])
}

/// Backing store for the zero-infra `db` storage driver. Swapped out wholesale
/// when STORAGE_DRIVER=s3.
model StorageObject {
  key         String   @id
  contentType String
  gzipped     Bytes
  size        Int
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Usage / rate limiting (RateLimiterPrisma-compatible)
// ---------------------------------------------------------------------------

model Usage {
  key       String    @id
  points    Int
  expire    DateTime?
  unlimited Boolean   @default(false)
}
